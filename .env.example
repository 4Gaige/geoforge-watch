# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Optional AI provider keys (any one; Gemini has a free tier at aistudio.google.com)
GEMINI_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
# Set to 1 to force mock checkout
GFW_MOCK=
